# Copy to .env.local. Never commit real passwords or connection strings.
# Runtime: copy the transaction pooler URL from Supabase Connect (port 6543).
DATABASE_URL=postgresql://fuel_runtime.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Alternatives supported when DATABASE_URL is absent: SUPABASE_DB_URL, POSTGRES_URL.
# Do not use SUPABASE_URL (https), anon key or service-role key here.
# Migration only: direct connection, or session pooler on an IPv4-only network.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Required only for tests. Must use a dedicated test database ending in _test.
TEST_DATABASE_URL=
# Local provisioning only; never set this or MIGRATION_DATABASE_URL on Vercel.
RUNTIME_DB_PASSWORD=
APP_ORIGIN=http://127.0.0.1:8000
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
PRICE_FETCH_TIMEOUT_SECONDS=15
